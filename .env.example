# Application
APP_NAME=rag-pipeline
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,txt,md,docx,csv,xlsx

# Local Storage & Logs
LOCAL_STORAGE_DIR=./data/uploads
SQLITE_STORAGE_DIR=./data/sqlite
ENABLE_FILE_LOGS=false
LOG_FILE_PATH=./logs/rag_pipeline.log

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-hybrid-index
PINECONE_NAMESPACE=default
PINECONE_TOP_K=20
RERANK_TOP_M=5

# Redis Cache Layer
REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_TTL_SECONDS=86400

# LLM & Embeddings (Model, API Key & Temperature)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-small
MULTI_QUERY_COUNT=3
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Reranker & Evaluation
RERANKER_PROVIDER=sentence-transformers
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=
ENABLE_ASYNC_EVALUATION=true
EVAL_CACHE_MIN_SCORE=0.75
